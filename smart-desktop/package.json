{
  "name": "smart-teacher-desktop",
  "version": "4.0.0",
  "description": "스마트 바탕화면 - 교사 & 직장인용 AI 대시보드",
  "main": "src/main/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev:react": "react-scripts start",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "react-scripts build && npm run build:electron",
    "build:electron": "electron-builder --win --mac",
    "build:win": "react-scripts build && electron-builder --win",
    "build:mac": "react-scripts build && electron-builder --mac"
  },
  "keywords": [
    "electron",
    "react",
    "teacher",
    "desktop",
    "dashboard"
  ],
  "author": "SmartDesktop",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^2.5.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.6.0",
    "date-fns": "^3.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "googleapis": "^128.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "wait-on": "^7.2.0"
  },
  "homepage": "./",
  "build": {
    "appId": "com.smartdesktop.teacher",
    "productName": "스마트 바탕화면",
    "extends": null,
    "files": [
      "build/**/*",
      "src/main/**/*"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "wizbeee",
      "repo": "smart-teacher-desktop",
      "releaseType": "release"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
